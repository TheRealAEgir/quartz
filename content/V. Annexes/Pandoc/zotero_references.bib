@article{Chen_Immunity_2014,
  title = {In Vivo {{RNA}} Interference Screens Identify Regulators of Antiviral {{CD4}}+ and {{CD8}}+ {{T}} Cell Differentiation},
  author = {Chen, Runqiang and B{\'e}langer, Simon and Frederick, Megan A. and Li, Bin and Johnston, Robert J. and Xiao, Nengming and Liu, Yun-Cai and Sharma, Sonia and Peters, Bjoern and Rao, Anjana and Crotty, Shane and Pipkin, Matthew E.},
  year = 2014,
