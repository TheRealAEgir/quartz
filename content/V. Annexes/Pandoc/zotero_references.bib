@article{Lam_Immunity_2025,
  title = {Asynchronous Aging and Turnover of Human Circulating and Tissue-Resident Memory {{T}} Cells across Sites},
  author = {Lam, Nora and Angel, J. Carlos and Buchholz, Bruce A. and Lee, YoonSeung and Weisberg, Stuart P. and Brown, Brea H. and {Davis-Porada}, Julia and Caron, Daniel P. and Jensen, Isaac J. and Szabo, Peter A. and Ural, Basak B. and Wells, Steven B. and Kubota, Masaru and Matsumoto, Rei and Brusko, Maigan and Brusko, Todd M. and Lu, Chao and Yates, Andrew J. and Farber, Donna L.},
  year = 2025,
  month = sep,
  journal = {Immunity},
  volume = {58},
  number = {9},
  pages = {2271-2288.e6},
  issn = {1074-7613},
  doi = {10.1016/j.immuni.2025.07.001},
  urldate = {2026-07-10},
  abstract = {Memory T cells are maintained in tissues as circulating effector-memory (TEM) and tissue-resident (TRM) populations for protective immunity, though the role of site and subset in memory persistence remains undefined. Here, we investigated age-associated dynamics of human T cells in lymphoid organs, mucosal sites, and blood over 10 decades of life using retrospective radiocarbon (14C) birth dating, along with cellular, transcriptome, and epigenetic profiling. Memory T cells across peripheral sites exhibited continuous turnover with mean lifespans of 1--2 years, while the spleen contained longer-lived T cells. Over age, TEM cells expressed senescent markers and a GZMK transcriptional signature, while TRM cells maintained site-specific resident phenotypes without exhibiting features of senescence. Both TEM and TRM cells showed age-associated DNA hypomethylation, though TRM cells exhibited more epigenetically regulated genes. Together, our findings reveal asynchronous aging of human memory T cells by subset and site, as well as persistence of TRM cells without immunosenescence.},
  keywords = {aging,epigenetics,histology,immunosenescence,mucosal immunity,T cells,tissue-resident memory T cells},
  annotation = {26 citations (Crossref/DOI) [2026-10-26]\\
16 citations (Crossref/DOI) [2026-07-10]},
  file = {C\:\\Users\\10053234\\Documents\\Thesis_bibliography\\Zotero\\storage\\22VSDYLG\\Lam et al. - 2025 - Asynchronous aging and turnover of human circulating and tissue-resident memory T cells across sites.pdf;C\:\\Users\\10053234\\Documents\\Thesis_bibliography\\Zotero\\storage\\NGIV9F4A\\S1074761325003103.html}
}

@article{Lan_NatImmunol_2024,
  title = {Antitumor Progenitor Exhausted {{CD8}}+ {{T}} Cells Are Sustained by {{TCR}} Engagement},
  author = {Lan, Xin and Mi, Tian and Alli, Shanta and Guy, Cliff and Djekidel, Mohamed Nadhir and Liu, Xueyan and Boi, Shannon and Chowdhury, Partha and He, Minghong and Zehn, Dietmar and Feng, Yongqiang and Youngblood, Ben},
  year = 2024,
  month = jun,
  journal = {Nature Immunology},
  volume = {25},
  number = {6},
  pages = {1046--1058},
  publisher = {Nature Publishing Group},
  issn = {1529-2916},
  doi = {10.1038/s41590-024-01843-8},
  urldate = {2026-04-03},
  abstract = {The durability of an antitumor immune response is mediated in part by the persistence of progenitor exhausted CD8+ T cells (Tpex). Tpex serve as a resource for replenishing effector T cells and preserve their quantity through self-renewal. However, it is unknown how T cell receptor (TCR) engagement affects the self-renewal capacity of Tpex in settings of continued antigen exposure. Here we use a Lewis lung carcinoma model that elicits either optimal or attenuated TCR signaling in CD8+ T cells to show that formation of Tpex in tumor-draining lymph nodes and their intratumoral persistence is dependent on optimal TCR engagement. Notably, attenuated TCR stimulation accelerates the terminal differentiation of optimally primed Tpex. This TCR-reinforced Tpex development and self-renewal is coupled to proximal positioning to dendritic cells and epigenetic imprinting involving increased chromatin accessibility at Egr2 and Tcf1 target loci. Collectively, this study highlights the critical function of TCR engagement in sustaining Tpex during tumor progression.},
  copyright = {2024 The Author(s), under exclusive licence to Springer Nature America, Inc.},
  langid = {english},
  keywords = {Cytotoxic T cells,Immunosurveillance,Immunotherapy,Tumour immunology},
  annotation = {58 citations (Crossref/DOI) [2026-10-26]\\
41 citations (Crossref/DOI) [2026-05-26]\\
38 citations (Crossref/DOI) [2026-04-14]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\IM26JZV8\Lan et al. - 2024 - Antitumor progenitor exhausted CD8+ T cells are sustained by TCR engagement.pdf}
}

@article{lanEpigeneticControlTissue2025a,
  title = {Epigenetic Control of Tissue Resident Memory {{T}} Cells},
  author = {Lan, Zhiyi and Chen, Zeyu and Yang, Nan and Liu, Tong and Li, Siqi and Shi, Yuling and Gu, Jun},
  year = 2025,
  month = aug,
  journal = {Frontiers in Immunology},
  volume = {16},
  pages = {1605972},
  issn = {1664-3224},
  doi = {10.3389/fimmu.2025.1605972},
  urldate = {2026-03-12},
  abstract = {Tissue-resident memory T cells (TRM) represent a heterogeneous population of T cells that exhibit both effector and memory functionalities. They express specific gene signatures that enable them to occupy tissues without recirculating, thus providing a first response against reencountered pathogens or antigens. TRM have been implicated in the pathogenesis of various diseases, including autoimmune disorders, infections, and cancers. This has prompted interest in targeting TRM as a potential therapeutic strategy. Epigenetic modifications, which frequently occur in immune cells across various disease states, play a significant role not only in tissue homeostasis but also in disease progression. Emerging evidence suggests that the epigenetic landscape of TRM is altered in pathogenic conditions, impacting their differentiation, maintenance, and function. Nevertheless, the precise mechanisms remain poorly understood. This review seeks to provide a comprehensive overview of the epigenetic regulation of TRM, focusing on key areas such as chromatin accessibility, DNA methylation, histone modifications, and non-coding RNAs. Importantly, a deeper understanding of these epigenetic mechanisms will pave the way for novel therapeutic strategies, such as modulating TRM activity in autoimmune diseases, enhancing tissue-specific immunity through vaccines, or improving immunotherapeutic efficacy in cancer.},
  pmcid = {PMC12394232},
  pmid = {40895552},
  annotation = {6 citations (Crossref/DOI) [2026-10-26]\\
0 citations (Crossref/DOI) [2026-05-26]\\
