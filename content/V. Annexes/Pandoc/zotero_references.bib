@article{Webb_CancerImmunolRes_2015,
  title = {{{PD-1}} and {{CD103 Are Widely Coexpressed}} on {{Prognostically Favorable Intraepithelial CD8 T Cells}} in {{Human Ovarian Cancer}}},
  author = {Webb, John R. and Milne, Katy and Nelson, Brad H.},
