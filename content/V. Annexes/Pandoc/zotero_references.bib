@article{Fonseca_NatImmunol_2020,
  title = {Developmental Plasticity Allows Outside-in Immune Responses by Resident Memory {{T}} Cells},
  author = {Fonseca, Raissa and Beura, Lalit K and Quarnstrom, Clare F and Ghoneim, Hazem E and Fan, Yiping and Zebley, Caitlin C and Scott, Milcah C and {Fares-Frederickson}, Nancy J and Wijeyesinghe, Sathi and Thompson, Emily A and {da Silva}, Henrique Borges and Vezys, Vaiva and Youngblood, Benjamin and Masopust, David},
  year = 2020,
