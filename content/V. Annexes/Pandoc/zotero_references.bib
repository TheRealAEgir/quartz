}

@article{Liikanen_JClinInvest_,
  title = {Hypoxia-Inducible Factor Activity Promotes Antitumor Effector Function and Tissue Residency by {{CD8}}+ {{T}} Cells},
  author = {Liikanen, Ilkka and Lauhan, Colette and Quon, Sara and Omilusik, Kyla and Phan, Anthony T. and Bartrol{\'i}, Laura Barcel{\'o} and Ferry, Amir and Goulding, John and Chen, Joyce and {Scott-Browne}, James P. and Yustein, Jason T. and Scharping, Nicole E. and Witherden, Deborah A. and Goldrath, Ananda W.},
  journal = {The Journal of Clinical Investigation},
  volume = {131},
  number = {7},
  pages = {e143729},
  issn = {0021-9738},
  doi = {10.1172/JCI143729},
  urldate = {2026-04-06},
  abstract = {Adoptive T cell therapies (ACTs) hold great promise in cancer treatment, but low overall response rates in patients with solid tumors underscore remaining challenges in realizing the potential of this cellular immunotherapy approach. Promoting CD8+ T cell adaptation to tissue residency represents an underutilized but promising strategy to improve tumor-infiltrating lymphocyte (TIL) function. Here, we report that deletion of the HIF negative regulator von Hippel-Lindau (VHL) in CD8+ T cells induced HIF-1{$\alpha$}/HIF-2{$\alpha$}--dependent differentiation of tissue-resident memory--like (Trm-like) TILs in mouse models of malignancy. VHL-deficient TILs accumulated in tumors and exhibited a core Trm signature despite an exhaustion-associated phenotype, which led to retained polyfunctionality and response to {$\alpha$}PD-1 immunotherapy, resulting in tumor eradication and protective tissue-resident memory. VHL deficiency similarly facilitated enhanced accumulation of chimeric antigen receptor (CAR) T cells with a Trm-like phenotype in tumors. Thus, HIF activity in CD8+ TILs promotes accumulation and antitumor activity, providing a new strategy to enhance the efficacy of ACTs.,},
  pmcid = {PMC8011896},
  pmid = {33792560},
  annotation = {160 citations (Crossref/DOI) [2026-10-26]\\
144 citations (Crossref/DOI) [2026-05-26]\\
