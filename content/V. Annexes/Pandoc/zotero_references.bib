  author = {Corgnac, St{\'e}phanie and Malenica, Ines and Mezquita, Laura and Auclin, Edouard and Voilin, Elodie and Kacher, Jamila and Halse, Heloise and Grynszpan, Laetitia and Signolle, Nicolas and Dayris, Thibault and Leclerc, Marine and Droin, Nathalie and {de Montpr{\'e}ville}, Vincent and Mercier, Olaf and Validire, Pierre and Scoazec, Jean-Yves and Massard, Christophe and Chouaib, Salem and Planchard, David and Adam, Julien and Besse, Benjamin and {Mami-Chouaib}, Fathia},
  year = 2020,
