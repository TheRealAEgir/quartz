@article{Wu_JLeukocBiol_2014,
  title = {Lung-Resident Memory {{CD8 T}} Cells ({{TRM}}) Are Indispensable for Optimal Cross-Protection against Pulmonary Virus Infection},
  author = {Wu, Tao and Hu, Yinghong and Lee, Young-Tae and Bouchard, Keith R. and Benechet, Alexandre and Khanna, Kamal and Cauley, Linda S.},
  year = 2014,
