@article{Beura_Immunity_2018,
  title = {T Cells in Non-Lymphoid Tissues Give Rise to Lymph Node Resident Memory {{T}} Cells},
  author = {Beura, Lalit K. and Wijeyesinghe, Sathi and Thompson, Emily A. and Macchietto, Marissa G. and Rosato, Pamela C. and Pierson, Mark J. and Schenkel, Jason M. and Mitchell, Jason S. and Vezys, Vaiva and Fife, Brian T. and Shen, Steven and Masopust, David},
