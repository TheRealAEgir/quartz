@article{Hu_Gastroenterology_2024,
  title = {Tertiary {{Lymphoid Structure-Associated B Cells Enhance CXCL13}}+{{CD103}}+{{CD8}}+ {{Tissue-Resident Memory T-Cell Response}} to {{Programmed Cell Death Protein}} 1 {{Blockade}} in {{Cancer Immunotherapy}}},
  author = {Hu, Chupeng and You, Wenhua and Kong, Deyuan and Huang, Yedi and Lu, JinYing and Zhao, Mengya and Jin, Yu and Peng, Rui and Hua, Dong and Kuang, Dong-Ming and Chen, Yun},
  year = 2024,
  month = jun,
  journal = {Gastroenterology},
  volume = {166},
  number = {6},
  pages = {1069--1084},
  issn = {0016-5085},
  doi = {10.1053/j.gastro.2023.10.022},
  urldate = {2026-08-13},
  abstract = {Background \& Aims Although the presence of tertiary lymphoid structures (TLS) correlates with positive responses to immunotherapy in many solid malignancies, the mechanism by which TLS enhances antitumor immunity is not well understood. The present study aimed to investigate the underlying cross talk circuits between B cells and tissue-resident memory T (Trm) cells within the TLS and to understand their role in the context of immunotherapy. Methods Immunostaining and H\&E staining of TLS and chemokine (C-X-C motif) ligand 13 (CXCL13)+ cluster of differentiation (CD)103+CD8+ Trm cells were performed on tumor sections from patients with gastric cancer (GC). The mechanism of communication between B cells and CXCL13+CD103+CD8+ Trm cells was determined in~vitro and in~vivo. The effect of CXCL13+CD103+CD8+ Trm cells in suppressing tumor growth was evaluated through anti--programmed cell death protein (PD)-1 therapy. Results The presence of TLS and CXCL13+CD103+CD8+ Trm cells in tumor tissues favored a superior response to anti--PD-1 therapy in patients with GC. Additionally, our research identified that activated B cells enhanced CXCL13 and granzyme B secretion by CD103+CD8+ Trm cells. Mechanistically, B cells facilitated the glycolysis of CD103+CD8+ Trm cells through the lymphotoxin-{$\alpha$}/tumor necrosis factor receptor 2 (TNFR2) axis, and the mechanistic target of rapamycin signaling pathway played a critical role in CD103+CD8+ Trm cells glycolysis during this~process. Moreover, the presence of TLS and CXCL13+CD103+CD8+ Trm cells correlated with potent responsiveness to anti--PD-1 therapy in a TNFR2-dependent manner. Conclusions This study further reveals a crucial role for cellular communication between TLS-associated B cell and CXCL13+CD103+CD8+ Trm cells in antitumor immunity, providing valuable insights into the potential use of the lymphotoxin-{$\alpha$}/TNFR2 axis within CXCL13+CD103+CD8+ Trm cells for advancing immunotherapy strategies in GC.},
  keywords = {CXCL13CD103CD8 Trm Cell,Gastric Cancer,Immunotherapy,Tertiary Lymphoid Structure,TNFR2},
  annotation = {110 citations (Crossref/DOI) [2026-10-26]\\
92 citations (Crossref/DOI) [2026-08-13]},
  file = {C\:\\Users\\10053234\\Documents\\Thesis_bibliography\\Zotero\\storage\\I5S69VBK\\Hu et al. - 2024 - Tertiary Lymphoid Structure-Associated B Cells Enhance CXCL13+CD103+CD8+ Tissue-Resident Memory T-Ce.pdf;C\:\\Users\\10053234\\Documents\\Thesis_bibliography\\Zotero\\storage\\ZEVH8YII\\S0016508523051983.html}
}

@article{Hu_JImmunol_2015,
  title = {Smad4 Promotes Differentiation of Effector and Circulating Memory {{CD8 T}} Cells but Is Dispensable for Tissue-Resident Memory {{CD8 T}} Cells},
  author = {Hu, Yinghong and Lee, Young-Tae and Kaech, Susan M. and Garvy, Beth and Cauley, Linda S.},
  year = 2015,
  month = mar,
  journal = {Journal of Immunology},
  volume = {194},
  number = {5},
  pages = {2407--2414},
  address = {Baltimore, Md. : 1950},
  issn = {1550-6606},
  doi = {10.4049/jimmunol.1402369},
  abstract = {Tissue-resident memory CD8 T cells are a unique subset of virus-specific CTLs that bolster local immune responses after becoming lodged in previously infected tissues. These cells provide enhanced protection by intercepting returning pathogens before a new infection gets established. In contrast, central memory CD8 T cells circulate in the bloodstream and proliferate in secondary lymphoid organs before replenishing effector and memory CD8 T cell populations in remote parts of the body. Both populations of virus-specific memory CD8 T cells participate in immunity to influenza virus infection; however, the signaling pathways that instruct developing memory CD8 T cells to distribute to specific tissues are poorly defined. We show that TGF-{$\beta$} promotes the development of pulmonary tissue-resident memory T cells via a signaling pathway that does not require the downstream signaling intermediate Sma- and Mad-related protein (Smad)4. In contrast, circulating memory CD8 T cells have no requirement for TGF-{$\beta$} but show signs of arrested development in the absence of Smad4, including aberrant CD103 expression. These signaling pathways alter the distribution of virus-specific CTLs in the lungs but do not prevent robust cytokine responses. Our data show that Smad4 is required for normal differentiation of multiple subsets of virus-specific CD8 T cells. In normal circumstances, Smad4 may be activated via a pathway that bypasses the TGF-{$\beta$} receptor. Improved understanding of these signaling pathways could be used to augment vaccine-induced immunity.},
  langid = {english},
