}

@article{Thompson_CellRep_2019,
  title = {Monocytes {{Acquire}} the {{Ability}} to {{Prime Tissue-Resident T Cells}} via {{IL-10-Mediated TGF-$\beta$ Release}}},
  author = {Thompson, Elizabeth A. and Darrah, Patricia A. and Foulds, Kathryn E. and Hoffer, Elena and {Caffrey-Carr}, Alayna and Norenstedt, Sophie and Perbeck, Leif and Seder, Robert A. and Kedl, Ross M. and Lor{\'e}, Karin},
  year = 2019,
  month = jul,
  journal = {Cell reports},
  volume = {28},
  number = {5},
  pages = {1127-1135.e4},
  issn = {2211-1247},
  doi = {10.1016/j.celrep.2019.06.087},
  urldate = {2026-03-19},
  abstract = {Using non-human primates (NHPs), mice, and human primary cells, we found a role for interleukin-10 (IL-10) in the upregulation of the tissue-resident memory T cell (TRM) marker CD103. In NHPs, intravenous, but not subcutaneous, immunization with peptide antigen and an adjuvant combining an agonistic anti-CD40 antibody plus poly(IC:LC) induced high levels of CD103+ TRMs in the lung, which correlated with early plasma IL-10 levels. Blocking IL-10 reduced CD103 expression on human T cells stimulated in vitro with the adjuvant combination as well as diminished CD103 on lung-resident T cells in vivo in mice. Monocyte-produced IL-10 induced the release of surface-bound transforming growth factor {$\beta$} (TGF-{$\beta$}), which in turn upregulated CD103 on T cells. Early TGF-{$\beta$} imprinted increased sensitivity to TGF-{$\beta$} restimulation, indicating an early commitment of the T cell lineage toward TRMs during the priming stage of activation. IL-10-mediated TGF-{$\beta$} signaling may therefore have a critical role in the generation of TRM following vaccination., , Thompson et al. outline a role for early IL-10 following immunization in the release of TGF-{$\beta$} and subsequent differentiation of CD103+ TRMs. Using a combination of non-human primate, human, and murine systems, the authors demonstrate that blocking IL-10 reduces CD103 expression, whereas delivery of IL-10 can augment a CD103+ phenotype.},
  pmcid = {PMC6825402},
  pmid = {31365858},
  annotation = {70 citations (Crossref/DOI) [2026-10-26]\\
65 citations (Crossref/DOI) [2026-05-26]\\
63 citations (Crossref/DOI) [2026-03-24]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\ILHGF4GD\Thompson et al. - 2019 - Monocytes Acquire the Ability to Prime Tissue-Resident T Cells via IL-10-Mediated TGF-β Release.pdf}
}

@article{Thompson_JImmunol_2015b,
