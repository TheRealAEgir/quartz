}

@article{Joshi_Immunity_2007,
  title = {Inflammation {{Directs Memory Precursor}} and {{Short-Lived Effector CD8}}(+) {{T Cell Fates}} via the {{Graded Expression}} of {{T-bet Transcription Factor}}},
  author = {Joshi, Nikhil S. and Cui, Weiguo and Chandele, Anmol and Lee, Heung Kyu and Urso, David R. and Hagman, James and Gapin, Laurent and Kaech, Susan M.},
  year = 2007,
  month = aug,
  journal = {Immunity},
  volume = {27},
  number = {2},
  pages = {281--295},
  issn = {1074-7613},
  doi = {10.1016/j.immuni.2007.07.010},
  urldate = {2026-09-17},
  abstract = {As acute infections resolve, effector CD8 T cells differentiate into IL-7Rlo short-lived effector cells (SLECs) and IL-7Rhi memory precursor effector cells (MPECs) capable of generating long-lived memory CD8 T cells. Using another SLEC marker, KLRG1, we found that KLRG1hi effector cells began appearing early during infection and were committed to downregulating IL-7R. Unlike IL-7Rhi MPECs, KLRG1hi IL-7Rlo SLECs relied on IL-15, but IL-15 could not sustain their long-term maintenance or homeostatic turnover. The SLEC/MPEC fate decision was regulated by the amount of inflammatory cytokines (i.e. IL-12) present during T cell priming. According to the amount of inflammation, a gradient of T-bet was created in which high T-bet levels induced SLECs and low levels promoted MPECs. These results elucidate a novel mechanism by which the innate immune system sets the relative levels of a lineage-determining transcription factor in activated CD8 T cells and correspondingly, regulates their memory cell potential.},
  pmcid = {PMC2034442},
  pmid = {17723218},
  annotation = {1743 citations (Crossref/DOI) [2026-10-26]\\
1697 citations (Crossref/DOI) [2026-09-23]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\ZVWQV7RW\Joshi et al. - 2007 - Inflammation Directs Memory Precursor and Short-Lived Effector CD8(+) T Cell Fates via the Graded Ex.pdf}
}

