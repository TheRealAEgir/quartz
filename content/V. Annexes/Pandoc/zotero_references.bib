}

@article{Li_NatImmunol_2025,
  title = {Analysis of the Three-Dimensional Genome of Exhausted {{CD8}}+ {{T}} Cells Reveals a Critical Role of {{IRF8}} in Their Differentiation and Functions in Cancer},
  author = {Li, Ruifeng and Wei, Kun and Sun, Qinli and Xie, Bowen and Wei, Peng and Xie, Tian and Guo, Xinyi and Chen, Yongzhen and Pan, Birui and Zhao, Zixuan and Ni, Ling and Dong, Chen},
  year = 2025,
