  author = {Burn, Thomas N. and Schr{\"o}der, Jan and Gandolfo, Luke C. and Osman, Maleika and Wainwright, Elanor N. and Lam, Enid Y. N. and McDonald, Keely M. and Evans, Rachel B. and Li, Shihan and Rawlinson, Daniel and Dryburgh, Lachlan and Zaid, Ali and Maliga, Zoltan and Schienstock, Dominick and Meiser, Philippa and Lee, Hyun Jae and Lai, Hongjin and Moreira, Marcela L. and Zareie, Pirooz and Lee, Louis H.-Y. and Huq, Lutfi and Christo, Susan N. and Seow, Justine J. W. and Ching, Keith A. and Guillaume, St{\'e}phane M. and Knezevic, Kathy and Park, Simone L. and Evrard, Maximilien and Waithman, Jason and Gebhardt, Thomas and Mueller, Scott N. and Riddiough, Georgina E. and Perini, Marcos V. and Tsao, Simon C. H. and Speed, Terence P. and Sorger, Peter K. and Loi, Sherene and Carbone, Francis R. and Gras, Stephanie and Fisher, Timothy S. and Baaten, Bas J. and Dawson, Mark A. and Mackay, Laura K.},
  year = 2026,
  month = jan,
  journal = {Nature Immunology},
  volume = {27},
  number = {1},
  pages = {98--109},
  publisher = {Nature Publishing Group},
  issn = {1529-2916},
  doi = {10.1038/s41590-025-02347-9},
  urldate = {2026-04-07},
  abstract = {CD8+ T\,cells are an important weapon in the therapeutic armamentarium against cancer. While CD8+CD103+ T\,cells with a tissue-resident memory T (TRM) cell phenotype are associated with favorable prognoses, the tumor microenvironment also contains dysfunctional exhausted T (TEX) cells that exhibit a variety of TRM-like features. Here we deconvolute TRM and TEX cells across human cancers, ascribing markers and gene signatures that distinguish these populations and enable their functional distinction. Although TRM cells have superior functionality and are associated with long-term survival post-tumor resection, they are not associated with responsiveness to immune checkpoint blockade. Tumor-associated TEX and TRM cells are clonally distinct, with the latter comprising tumor-independent bystanders and tumor-specific cells segregated from cognate antigen. Intratumoral TRM cells can be forced toward an exhausted fate when chronic antigen stimulation occurs, indicating that the presence or absence of continuous antigen exposure within the microenvironment is the key distinction between tumor-associated TEX and TRM populations. These results highlight unique functions for TRM and TEX cells in tumor control, underscoring the need for distinct strategies to harness these populations for cancer therapies.},
  copyright = {2025 The Author(s)},
  langid = {english},
  keywords = {Immunological memory,Immunotherapy},
  annotation = {32 citations (Crossref/DOI) [2026-10-26]\\
32 citations (Crossref/DOI) [2026-10-26]\\
11 citations (Crossref/DOI) [2026-05-26]\\
5 citations (Crossref/DOI) [2026-04-14]},
