  pmid = {38033053},
  keywords = {CD8-Positive T-Lymphocytes,Humans,Immunologic Memory,Inducible T-Cell Co-Stimulator Ligand,Inducible T-Cell Co-Stimulator Protein,Interleukin-7,Memory T Cells,Proto-Oncogene Proteins c-maf,Skin,Th17 Cells},
