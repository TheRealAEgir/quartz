  author = {Philip, Mary and Fairchild, Lauren and Sun, Liping and Horste, Ellen L. and Camara, Steven and Shakiba, Mojdeh and Scott, Andrew C. and Viale, Agnes and Lauer, Peter and Merghoub, Taha and Hellmann, Matthew D. and Wolchok, Jedd D. and Leslie, Christina S. and Schietinger, Andrea},
