  keywords = {Animals,Biomarkers,CD8-Positive T-Lymphocytes,Dendritic Cells,Disease Models Animal,Fluorescent Antibody Technique,Humans,Immunity,Immunophenotyping,Lymphocytes Tumor-Infiltrating,Melanoma,Memory T Cells,Mice},
