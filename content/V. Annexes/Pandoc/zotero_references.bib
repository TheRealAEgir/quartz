@article{Malik_SciImmunol_2017,
  title = {Resident Memory {{T}} Cells in Skin Mediate Durable Immunity to Melanoma},
  author = {Malik, Brian T. and Byrne, Katelyn T. and Vella, Jennifer L. and Zhang, Peisheng and Shabaneh, Tamer B. and Steinberg, Shannon M. and Molodtsov, Aleksey K. and Bowers, Jacob S. and Angeles, Christina V. and Paulos, Chrystal M. and Huang, Yina H. and Turk, Mary Jo},
  year = 2017,
  month = apr,
  journal = {Science immunology},
  volume = {2},
