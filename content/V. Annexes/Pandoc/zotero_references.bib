@article{Rao_Immunity_2010,
  title = {The {{mTOR}} Kinase Determines Effector versus Memory {{CD8}}+ {{T}} Cell Fate by Regulating the Expression of Transcription Factors {{T-bet}} and {{Eomesodermin}}},
