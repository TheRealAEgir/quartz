@article{Obers_Immunity_2024,
  title = {Retinoic Acid and {{TGF-$\beta$}} Orchestrate Organ-Specific Programs of Tissue Residency},
  author = {Obers, Andreas and Poch, Tobias and Rodrigues, Grace and Christo, Susan N. and Gandolfo, Luke C. and Fonseca, Raissa and Zaid, Ali and Kuai, Joey En Yu and Lai, Hongjin and Zareie, Pirooz and Yakou, Marina H. and Dryburgh, Lachlan and Burn, Thomas N. and Dosser, James and Buquicchio, Frank A. and Lareau, Caleb A. and Walsh, Calum and Judd, Louise and Theodorou, Maria Rafailia and Gutbrod, Katharina and D{\"o}rmann, Peter and Kingham, Jenny and Stinear, Tim and Kallies, Axel and Schroeder, Jan and Mueller, Scott N. and Park, Simone L. and Speed, Terence P. and Satpathy, Ansuman T. and Phan, Tri Giang and Wilhelm, Christoph and Zaph, Colby and Evrard, Maximilien and Mackay, Laura K.},
  year = 2024,
  month = nov,
  journal = {Immunity},
  volume = {57},
  number = {11},
  pages = {2615-2633.e10},
  issn = {1097-4180},
  doi = {10.1016/j.immuni.2024.09.015},
  abstract = {Tissue-resident memory T (TRM) cells are integral to tissue immunity, persisting in diverse anatomical sites where they adhere to a common transcriptional framework. How these cells integrate distinct local cues to adopt the common TRM cell fate remains poorly understood. Here, we show that whereas skin TRM cells strictly require transforming growth factor {$\beta$} (TGF-{$\beta$}) for tissue residency, those in other locations utilize the metabolite retinoic acid (RA) to drive an alternative differentiation pathway, directing a TGF-{$\beta$}-independent tissue residency program in the liver and synergizing with TGF-{$\beta$} to drive TRM cells in the small intestine. We found that RA was required for the long-term maintenance of intestinal TRM populations, in part by impeding their retrograde migration. Moreover, enhanced RA signaling modulated TRM cell phenotype and function, a phenomenon mirrored in mice with increased microbial diversity. Together, our findings reveal RA as a fundamental component of the host-environment interaction that directs immunosurveillance in tissues.},
  langid = {english},
  pmid = {39406245},
  keywords = {Animals,CD8(+) T cells,Cell Differentiation,dirty mice,IEL,Immunologic Memory,Intestine Small,Liver,Mice,Mice Inbred C57BL,Mice Knockout,mucosal immunity,Organ Specificity,retinoic acid,Signal Transduction,Skin,T cell memory,T-Lymphocytes,tissue-resident memory Tcells,transforming growth factor beta,Transforming Growth Factor beta,Tretinoin,TRM cells},
  annotation = {59 citations (Crossref/DOI) [2026-10-26]\\
46 citations (Crossref/DOI) [2026-05-26]\\
