  author = {Lucas, Erin D. and Huggins, Matthew A. and Peng, Changwei and O'Connor, Christine and Gress, Abigail R. and Thefaine, Claire E. and Dehm, Emma M. and Kubota, Yoshiaki and Jameson, Stephen C. and Hamilton, Sara E.},
  year = 2024,
