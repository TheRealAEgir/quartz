}

@article{Morris_JCIInsight_,
  title = {Inflammescent {{CX3CR1}}+{{CD57}}+{{CD8}}+ {{T}} Cells Are Generated and Expanded by {{IL-15}}},
  author = {Morris, Stephen R. and Chen, Bonnie and Mudd, Joseph C. and Panigrahi, Soumya and Shive, Carey L. and Sieg, Scott F. and Cameron, Cheryl M. and Zidar, David A. and Funderburg, Nicholas T. and Younes, Souheil-Antoine and Rodriguez, Benigno and Gianella, Sara and Lederman, Michael M. and Freeman, Michael L.},
