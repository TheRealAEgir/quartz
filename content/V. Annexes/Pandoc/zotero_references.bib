@article{Ely_JImmunol_2006,
  title = {Memory {{T}} Cell Populations in the Lung Airways Are Maintained by Continual Recruitment},
  author = {Ely, Kenneth H. and Cookenham, Tres and Roberts, Alan D. and Woodland, David L.},
  year = 2006,
