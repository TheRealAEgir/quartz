@article{Kurd_SciImmunol_2020,
  title = {Early Precursors and Molecular Determinants of Tissue-Resident Memory {{CD8}}+ {{T}} Lymphocytes Revealed by Single-Cell {{RNA}} Sequencing},
  author = {Kurd, Nadia S. and He, Zhaoren and Louis, Tiani L. and Milner, J. Justin and Omilusik, Kyla D. and Jin, Wenhao and Tsai, Matthew S. and Widjaja, Christella E. and Kanbar, Jad N. and Olvera, Jocelyn G. and Tysl, Tiffani and Quezada, Lauren K. and Boland, Brigid S. and Huang, Wendy J. and Murre, Cornelis and Goldrath, Ananda W. and Yeo, Gene W. and Chang, John T.},
