  author = {Christo, Susan N. and Evrard, Maximilien and Park, Simone L. and Gandolfo, Luke C. and Burn, Thomas N. and Fonseca, Raissa and Newman, Dane M. and Alexandre, Yannick O. and Collins, Nicholas and Zamudio, Natasha M. and {Souza-Fonseca-Guimaraes}, Fernando and Pellicci, Daniel G. and Chisanga, David and Shi, Wei and Bartholin, Laurent and Belz, Gabrielle T. and Huntington, Nicholas D. and Lucas, Andrew and Lucas, Michaela and Mueller, Scott N. and Heath, William R. and Ginhoux, Florent and Speed, Terence P. and Carbone, Francis R. and Kallies, Axel and Mackay, Laura K.},
  year = 2021,
