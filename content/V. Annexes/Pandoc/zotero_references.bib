  author = {Galon, J{\'e}r{\^o}me and Costes, Anne and {Sanchez-Cabo}, Fatima and Kirilovsky, Amos and Mlecnik, Bernhard and {Lagorce-Pag{\`e}s}, Christine and Tosolini, Marie and Camus, Matthieu and Berger, Anne and Wind, Philippe and Zinzindohou{\'e}, Franck and Bruneval, Patrick and Cugnenc, Paul-Henri and Trajanoski, Zlatko and Fridman, Wolf-Herman and Pag{\`e}s, Franck},
