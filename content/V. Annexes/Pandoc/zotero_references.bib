@article{Park_NatMed_2015,
  title = {{{THE EMERGING ROLE OF RESIDENT MEMORY T CELLS IN PROTECTIVE IMMUNITY AND INFLAMMATORY DISEASE}}},
  author = {Park, Changook and Kupper, Thomas S},
  year = 2015,
