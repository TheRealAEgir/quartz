@article{Kuric_TheAmericanJournalofPathology_2017,
  title = {Demonstration of {{Tissue Resident Memory CD8 T Cells}} in {{Insulitic Lesions}} in {{Adult Patients}} with {{Recent-Onset Type}} 1 {{Diabetes}}},
  author = {Kuric, Enida and Seiron, Peter and Krogvold, Lars and Edwin, Bj{\o}rn and Buanes, Trond and Hanssen, Kristian F. and Skog, Oskar and {Dahl-J{\o}rgensen}, Knut and Korsgren, Olle},
