}

@article{Gaide_NatMed_2015,
  title = {Common Clonal Origin of Central and Resident Memory {{T}} Cells Following Skin Immunization},
  author = {Gaide, Olivier and Emerson, Ryan O. and Jiang, Xiaodong and Gulati, Nicholas and Nizza, Suzanne and Desmarais, Cindy and Robins, Harlan and Krueger, James G. and Clark, Rachael A. and Kupper, Thomas S.},
  year = 2015,
  month = jun,
  journal = {Nature medicine},
  volume = {21},
  number = {6},
  pages = {647--653},
  issn = {1078-8956},
  doi = {10.1038/nm.3860},
  urldate = {2026-03-18},
  abstract = {Central memory T (TCM) cells in lymph nodes (LN) and resident memory T (TRM) cells in peripheral tissues play distinct roles in protective immunity-. Both are generated after primary infections, but the clonal origin of TRM and TCM cells is unclear. To address this question, mice were immunized through the skin with either a protein antigen, a chemical hapten, or a non-replicating poxvirus. We then analyzed antigen activated T cells from different tissues using high-throughput sequencing (HTS) of the gene (Tcrbv) encoding T cell receptor gene {$\beta$} chain CDR3 region to simultaneously track thousands of unique T cells. For every abundant TRM clone generated in the skin, an abundant TCM clone bearing the identical TCR was present in lymph nodes (LN). Thus antigen reactive skin TRM and LN TCM clones were derived from a common naive T cell precursor after skin immunization, generating overlapping TCR repertoires. Although they bore the same TCR, TRM mediated rapid contact hypersensitivity (CHS) responses in mice, whereas TCM mediated delayed and attenuated responses. Studies in human subjects confirmed the generation of skin TRM in allergic contact dermatitis. Thus, immunization through skin simultaneously generates skin TRM and LN TCM in similar numbers from the same na\"ive T cells.},
  pmcid = {PMC4632197},
  pmid = {25962122},
  annotation = {280 citations (Crossref/DOI) [2026-10-26]\\
265 citations (Crossref/DOI) [2026-05-26]\\
264 citations (Crossref/DOI) [2026-03-24]},
