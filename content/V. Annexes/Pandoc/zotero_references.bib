  author = {Li, Can and Ligons, Davinna L. and Lanasa, Dominic and Keller, Hilary R. and Luckey, Megan A. and Capaldo, Brian and Meerzaman, Daoud and Park, Joo-Young and Park, Jung-Hyun},
  year = 2025,
