@article{yuanRolesTissueResidentMemory2021,
  title = {The {{Roles}} of {{Tissue-Resident Memory T Cells}} in {{Lung Diseases}}},
  author = {Yuan, Rui and Yu, Jiang and Jiao, Ziqiao and Li, Jinfei and Wu, Fang and Yan, Rongkai and Huang, Xiaojie and Chen, Chen},
