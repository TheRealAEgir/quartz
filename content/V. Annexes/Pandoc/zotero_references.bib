  keywords = {Animals,beta 2-Microglobulin,CD8-Positive T-Lymphocytes,Flow Cytometry,Glycoproteins,Histocompatibility Antigens Class I,Interferon-gamma,Lymphocytic choriomeningitis virus,Major Histocompatibility Complex,Membrane Glycoproteins,Mice,Mice Transgenic,Peptides,Perforin,Pore Forming Cytotoxic Proteins,Protein Conformation,Receptors Antigen T-Cell,Spleen,T-Lymphocytes Cytotoxic},
