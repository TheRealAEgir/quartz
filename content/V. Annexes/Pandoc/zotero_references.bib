@article{Collins_ImmunolCellBiol_2017,
  title = {Sustained Accumulation of Antigen-Presenting Cells after Infection Promotes Local {{T-cell}} Immunity},
  author = {Collins, Nicholas and Hochheiser, Katharina and Carbone, Francis R. and Gebhardt, Thomas},
  year = 2017,
  month = nov,
  journal = {Immunology and Cell Biology},
  volume = {95},
  number = {10},
  pages = {878--883},
  issn = {1440-1711},
  doi = {10.1038/icb.2017.60},
  abstract = {Antigen-presenting cells (APC), such as dendritic cells (DC) and macrophages, are critical for T-cell-mediated immunity. Although it is established that memory T cells accumulate and persist in peripheral tissues after the resolution of infection, whether this is also the case for APC remains unclear. Here, we report that CCR2-dependent cells infiltrate skin during acute infection with herpes simplex virus (HSV)-1 and subsequently give rise to localized populations of DCs and macrophages. These APC are found at elevated numbers at sites of resolved infection or inflammation compared with unaffected regions of skin. Importantly, this local accumulation of APC is sustained for prolonged periods of time and has important functional consequences, as it promotes interferon-{$\gamma$} responses by virus-specific CD4+ T cells upon localized challenge infection with HSV-1. Thus, our results highlight how infection history determines long-term changes in immune cell composition in skin and how different types of immune cells accumulate, persist and co-operate to provide optimal immunity at this critical barrier site.},
  langid = {english},
  pmid = {28722019},
  keywords = {Animals,Antigen Presentation,CD4-Positive T-Lymphocytes,Cell Movement,Dendritic Cells,Herpes Simplex,Humans,Interferon-gamma,Lymphocyte Activation,Macrophages,Mice,Mice Inbred C57BL,Mice Knockout,Receptors CCR2,Simplexvirus},
  annotation = {13 citations (Crossref/DOI) [2026-10-26]\\
12 citations (Crossref/DOI) [2026-05-26]\\
12 citations (Crossref/DOI) [2026-04-23]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\IC925XJU\Collins et al. - 2017 - Sustained accumulation of antigen-presenting cells after infection promotes local T-cell immunity.pdf}
