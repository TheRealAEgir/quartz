@article{Kallies_NatRevImmunol_2020,
  title = {Precursor Exhausted {{T}} Cells: Key to Successful Immunotherapy?},
  shorttitle = {Precursor Exhausted {{T}} Cells},
  author = {Kallies, Axel and Zehn, Dietmar and Utzschneider, Daniel T.},
