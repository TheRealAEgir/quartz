@article{Herndler-Brandstetter_Immunity_2018,
  title = {{{KLRG1}}+ {{Effector CD8}}+ {{T Cells Lose KLRG1}}, {{Differentiate}} into {{All Memory T Cell Lineages}}, and {{Convey Enhanced Protective Immunity}}},
  author = {{Herndler-Brandstetter}, Dietmar and Ishigame, Harumichi and Shinnakasu, Ryo and Plajer, Valerie and Stecher, Carmen and Zhao, Jun and Lietzenmayer, Melanie and Kroehling, Lina and Takumi, Akiko and Kometani, Kohei and Inoue, Takeshi and Kluger, Yuval and Kaech, Susan M. and Kurosaki, Tomohiro and Okada, Takaharu and Flavell, Richard A.},
  year = 2018,
