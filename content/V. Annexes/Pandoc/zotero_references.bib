  pmid = {33827905},
  keywords = {Antibodies Monoclonal Humanized,Antigens CD,B7-H1 Antigen,biomarkers,Biomarkers Tumor,CD8-positive T-lymphocytes,CD8-Positive T-Lymphocytes,Clinical Trials Phase II as Topic,Clinical Trials Phase III as Topic,Databases Genetic,gene expression profiling,Gene Expression Profiling,Humans,Immune Checkpoint Inhibitors,immunotherapy,Integrin alpha Chains,Lung Neoplasms,lymphocytes,Lymphocytes Tumor-Infiltrating,Phenotype,Randomized Controlled Trials as Topic,Time Factors,Treatment Outcome,tumor,Tumor Microenvironment,tumor-infiltrating,Urinary Bladder Neoplasms},
