}

@article{Utzschneider_Immunity_2016,
  title = {T {{Cell Factor}} 1-{{Expressing Memory-like CD8}}+ {{T Cells Sustain}} the {{Immune Response}} to {{Chronic Viral Infections}}},
  author = {Utzschneider, Daniel T. and Charmoy, M{\'e}lanie and Chennupati, Vijaykumar and Pousse, Laur{\`e}ne and Ferreira, Daniela Pais and {Calderon-Copete}, Sandra and Danilo, Maxime and Alfei, Francesca and Hofmann, Maike and Wieland, Dominik and Pradervand, Sylvain and Thimme, Robert and Zehn, Dietmar and Held, Werner},
