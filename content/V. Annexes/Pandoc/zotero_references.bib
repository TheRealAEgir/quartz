166 citations (Crossref/DOI) [2026-03-24]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\3IUN6R84\Behr et al. - 2020 - Tissue-resident memory CD8+ T cells shape local and systemic secondary T cell responses.pdf}
}

@article{behrArmedReadyTranscriptional2018,
  title = {Armed and {{Ready}}: {{Transcriptional Regulation}} of {{Tissue-Resident Memory CD8 T Cells}}},
  shorttitle = {Armed and {{Ready}}},
  author = {Behr, Felix M. and Chuwonpad, Ammarina and Stark, Regina and {van Gisbergen}, Klaas P. J. M.},
  year = 2018,
  month = jul,
  journal = {Frontiers in Immunology},
  volume = {9},
  pages = {1770},
  issn = {1664-3224},
  doi = {10.3389/fimmu.2018.01770},
  urldate = {2026-03-12},
  abstract = {A fundamental benefit of immunological memory is the ability to respond in an enhanced manner upon secondary encounter with the same pathogen. Tissue-resident memory CD8 T (TRM) cells contribute to improved protection against reinfection through the generation of immediate effector responses at the site of pathogen entry. Key to the potential of TRM cells to develop rapid recall responses is their location within the epithelia of the skin, lungs, and intestines at prime entry sites of pathogens. TRM cells are among the first immune cells to respond to pathogens that have been previously encountered in an antigen-specific manner. Upon recognition of invading pathogens, TRM cells release IFN-{$\gamma$} and other pro-inflammatory cytokines and chemokines. These effector molecules activate the surrounding epithelial tissue and recruit other immune cells including natural killer (NK) cells, B cells, and circulating memory CD8 T cells to the site of infection. The repertoire of TRM effector functions also includes the direct lysis of infected cells through the release of cytotoxic molecules such as perforin and granzymes. The mechanisms enabling TRM cells to respond in such a rapid manner are gradually being uncovered. In this review, we will address the signals that instruct TRM generation and maintenance as well as the underlying transcriptional network that keeps TRM cells in a deployment-ready modus. Furthermore, we will discuss how TRM cells respond to reinfection of the tissue and how transcription factors may control immediate and proliferative TRM responses.},
  pmcid = {PMC6090154},
  pmid = {30131803},
  annotation = {123 citations (Crossref/DOI) [2026-10-26]\\
113 citations (Crossref/DOI) [2026-05-26]\\
111 citations (Crossref/DOI) [2026-03-12]\\
107 citations (Semantic Scholar/DOI) [2026-03-12]\\
111 citations (Crossref/DOI) [2026-03-12]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\HVPTAEWN\Behr et al. - 2018 - Armed and Ready Transcriptional Regulation of Tissue-Resident Memory CD8 T Cells.pdf}
}

@article{Bergsbaken_CellRep_2017,
  title = {Local {{Inflammatory Cues Regulate Differentiation}} and {{Persistence}} of {{CD8}}+ {{Tissue-Resident Memory T Cells}}},
  author = {Bergsbaken, Tessa and Bevan, Michael J. and Fink, Pamela J.},
  year = 2017,
