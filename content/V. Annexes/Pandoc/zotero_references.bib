  author = {Edwards, Jarem and Wilmott, James S. and Madore, Jason and Gide, Tuba Nur and Quek, Camelia and Tasker, Annie and Ferguson, Angela and Chen, Jinbiao and Hewavisenti, Rehana and Hersey, Peter and Gebhardt, Thomas and Weninger, Wolfgang and Britton, Warwick J. and Saw, Robyn P. M. and Thompson, John F. and Menzies, Alexander M. and Long, Georgina V. and Scolyer, Richard A. and Palendira, Umaimainthan},
