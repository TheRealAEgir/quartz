@article{xuTissueResidentMemoryCell2023,
  title = {Tissue-{{Resident Memory T Cell}}: {{Ontogenetic Cellular Mechanism}} and {{Clinical Translation}}},
  shorttitle = {Tissue-{{Resident Memory T Cell}}},
