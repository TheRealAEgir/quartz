}

@article{Amsen_NatImmunol_2018,
  title = {Tissue-Resident Memory {{T}} Cells at the Center of Immunity to Solid Tumors},
  author = {Amsen, Derk and {van Gisbergen}, Klaas P. J. M. and Hombrink, Pleun and {van Lier}, Rene A. W.},
  year = 2018,
  month = jun,
  journal = {Nature Immunology},
  volume = {19},
  number = {6},
  pages = {538--546},
  issn = {1529-2916},
  doi = {10.1038/s41590-018-0114-2},
  abstract = {Immune responses in tissues are constrained by the physiological properties of the tissue involved. Tissue-resident memory T cells (TRM cells) are a recently discovered lineage of T cells specialized for life and function within tissues. Emerging evidence has shown that TRM cells have a special role in the control of solid tumors. A high frequency of TRM cells in tumors correlates with favorable disease progression in patients with cancer, and studies of mice have shown that TRM cells are necessary for optimal immunological control of solid tumors. Here we describe what defines TRM cells as a separate lineage and how these cells are generated. Furthermore, we discuss the properties that allow TRM cells to operate in normal and transformed tissues, as well as implications for the treatment of patients with cancer.},
  langid = {english},
  pmid = {29777219},
  keywords = {Animals,Humans,Immunologic Memory,Mice,Neoplasms,T-Lymphocyte Subsets,T-Lymphocytes},
  annotation = {290 citations (Crossref/DOI) [2026-10-26]\\
266 citations (Crossref/DOI) [2026-05-26]\\
264 citations (Crossref/DOI) [2026-04-23]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\LWALDX3G\Amsen et al. - 2018 - Tissue-resident memory T cells at the center of immunity to solid tumors.pdf}
}

@article{Anadon_CancerCell_2022,
  title = {Ovarian Cancer Immunogenicity Is Governed by a Narrow Subset of Progenitor Tissue-Resident Memory {{T-cells}}},
  author = {Anadon, Carmen M and Yu, Xiaoqing and Hanggi, Kay and Biswas, Subir and Chaurio, Ricardo and Martin, Alexandra and Payne, Kyle K and Mandal, Gunjan and Innamarato, Patrick and Harro, Carly M. and Mine, Jessica and Sprenger, Kimberly and Cortina, Carla and Powers, John J and Costich, Tara Lee and Perez, Bradford A. and Gatenbee, Chandler D. and Prabhakaran, Sandhya and Marchion, Douglas and Heemskerk, Mirjam H. and Curiel, Tyler J. and Anderson, Alexander R. and Wenham, Robert M. and Rodriguez, Paulo C. and {Conejo-Garcia}, Jose R},
  year = 2022,
  month = may,
  journal = {Cancer cell},
  volume = {40},
  number = {5},
  pages = {545-557.e13},
  issn = {1535-6108},
  doi = {10.1016/j.ccell.2022.03.008},
  urldate = {2026-05-13},
  abstract = {Despite repeated associations between T-cell infiltration and outcome, human ovarian cancer remains poorly responsive to immunotherapy. We report that hallmarks of tumor recognition in ovarian cancer-infiltrating T-cells are primarily restricted to tissue-resident memory (TRM) cells. Single-cell RNA/TCR/ATAC sequencing of 83,454 CD3+CD8+CD103+CD69+ TRM cells and immunohistochemistry of 122 high-grade serous ovarian cancers shows that only progenitor (TCF1low) tissue-resident T-cells (TRMstem cells), but not re-circulating TCF1+ T-cells, predict ovarian cancer outcome. TRMstem cells arise from transitional re-circulating T-cells, which depends on antigen affinity/persistence, resulting in oligoclonal, trogocytic, effector lymphocytes that eventually become exhausted. Therefore, ovarian cancer is indeed an immunogenic disease, but that depends on \textasciitilde 13\% of CD8+ tumor-infiltrating T-cells (\textasciitilde 3\% of CD8+ clonotypes), which are primed against high-affinity antigens and maintain waves of effector TRM-like cells. Our results define the signature of relevant tumor-reactive T cells in human ovarian cancer, which could be applicable to other tumors with unideal mutational burden.,  , Anadon et al demonstrate that human ovarian cancer-infiltrating T-cells exhibiting hallmarks of sustained and active tumor antigen recognition are restricted to \textasciitilde 13\% of CD8+ T-cells at tumor beds, corresponding to \textasciitilde 3\% of CD8+ clonotypes. These clonotypes represent TRM lymphocytes with a reservoir that retains features of stemness.},
  pmcid = {PMC9096229},
  pmid = {35427494},
  annotation = {184 citations (Crossref/DOI) [2026-10-26]\\
157 citations (Crossref/DOI) [2026-05-26]},
  file = {C:\Users\10053234\Documents\Thesis_bibliography\Zotero\storage\I7TVP7JK\Anadon et al. - 2022 - Ovarian cancer immunogenicity is governed by a narrow subset of progenitor tissue-resident memory T-.pdf}
}

