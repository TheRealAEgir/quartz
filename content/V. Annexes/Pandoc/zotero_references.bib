}

@article{christoMultifacetedRoleTissueResident2024,
  title = {The {{Multifaceted Role}} of {{Tissue-Resident Memory T Cells}}},
  author = {Christo, Susan N. and Park, Simone L. and Mueller, Scott N. and Mackay, Laura K.},
