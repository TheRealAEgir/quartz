@article{Hudson_Immunity_2019,
  title = {Proliferating {{Transitory T Cells}} with an {{Effector-like Transcriptional Signature Emerge}} from {{PD-1}}+ {{Stem-like CD8}}+ {{T Cells}} during {{Chronic Infection}}},
