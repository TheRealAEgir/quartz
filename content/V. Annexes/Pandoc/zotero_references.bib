  doi = {10.1038/nri.2015.3},
  urldate = {2026-03-11},
  abstract = {Tissue-resident CD4+ and CD8+ T cells have been identified in many tissues and organs of mice and humans. These cells are defined as those that undergo little or no recirculation.Tissue residency is not just a feature of subsets of memory {$\alpha\beta$} T cells. Other populations of immune cells, including regulatory T cells, natural killer T (NKT) cells, NK cells, {$\gamma\delta$} T cells and innate lymphoid cells have been defined as being permanently resident in tissues.Expression of CD69 and the integrin CD103 were originally defined as key markers of tissue-resident memory T cells (TRM cells). However, expression levels can differ between T cells in different tissues and TRM cells lacking both of these markers have now been described.TRM cell development involves several checkpoints, including tissue entry, local retention and subsequent responsiveness to local cytokines that support TRM cell formation and survival.TRM cells are crucial for local immunity and recall responses. New generation vaccines should be designed to induce both TRM cells and circulating memory T cells for optimal protection against infection.},
  copyright = {2015 Springer Nature Limited},
  langid = {english},
  keywords = {Cytotoxic T cells,Immunological memory,T-helper 1 cells},
  annotation = {998 citations (Crossref/DOI) [2026-10-26]\\
919 citations (Crossref/DOI) [2026-05-26]\\
