  keywords = {Adoptive Transfer,Animals,CD8-Positive T-Lymphocytes,Cell Differentiation,Cell Movement,Cell Survival,Immunologic Memory,Immunophenotyping,Lymphocyte Activation,Lymphocyte Count,Mice,Mice Inbred C57BL,Mice Knockout,Mice Transgenic,Vesicular stomatitis Indiana virus},
