}

@article{kokPrecursorsCD8Tissue2022,
  title = {The Precursors of {{CD8}}+ Tissue Resident Memory {{T}} Cells: From Lymphoid Organs to Infected Tissues},
  shorttitle = {The Precursors of {{CD8}}+ Tissue Resident Memory {{T}} Cells},
  author = {Kok, Lianne and Masopust, David and Schumacher, Ton N.},
  year = 2022,
  month = may,
  journal = {Nature Reviews. Immunology},
  volume = {22},
  number = {5},
  pages = {283--293},
  issn = {1474-1741},
  doi = {10.1038/s41577-021-00590-3},
  abstract = {CD8+ tissue resident memory T cells (TRM cells) are essential for immune defence against pathogens and malignancies, and the molecular processes that lead to TRM cell formation are therefore of substantial biomedical interest. Prior work has demonstrated that signals present in~the inflamed tissue micro-environment can promote the differentiation of memory precursor cells into mature TRM cells, and it was therefore long assumed that TRM cell formation adheres to a 'local divergence' model, in which TRM cell lineage decisions are exclusively made within the tissue. However, a growing body of work provides evidence for a 'systemic divergence' model, in which circulating T cells already become preconditioned to preferentially give rise to the TRM cell lineage, resulting in the generation of a pool of TRM cell-poised T cells within the lymphoid compartment. Here, we review the emerging evidence that supports the existence of such a population of circulating TRM cell progenitors, discuss current insights into their formation and highlight open questions in the field.},
  langid = {english},
  pmcid = {PMC8415193},
  pmid = {34480118},
  keywords = {CD8-Positive T-Lymphocytes,Cell Differentiation,Cell Lineage,Humans,Immunologic Memory,Memory T Cells},
  annotation = {214 citations (Crossref/DOI) [2026-10-26]\\
194 citations (Crossref/DOI) [2026-05-26]\\
183 citations (Crossref/DOI) [2026-03-12]\\
165 citations (Semantic Scholar/DOI) [2026-03-12]\\
183 citations (Crossref/DOI) [2026-03-12]},
